% DefCovST defines the covariance functions and bounds on the
% hyperparameters for the analysis of the spatio-temporal dataset in Ashe et al., 2018

refyear=1950; % reference year for GIA calculations (see RegressHoloceneDataSets.m)

%% define covariance functions 
kMat1 = @(dx,thetas) thetas(1).^2 .* (1).*exp(-dx/thetas(2)); % Squared Exponential (Ornstein–Uhlenbeck) kernel
kMat3 = @(dx,thetas) thetas(1).^2 .* (1 + sqrt(3)*dx/thetas(2)).*exp(-sqrt(3)*dx/thetas(2)); % Matern 3/2 kernel
kMat5 = @(dx,thetas) thetas(1).^2 .* (1 + (sqrt(5)*dx/thetas(2)).*(1 + sqrt(5)*dx/thetas(2)/3)).*exp(-sqrt(5)*dx/thetas(2)); % Matern 5/2 kernel
kDELTA = @(dx,thetas) thetas(1).^2 .* (dx==0); % Kronecker Delta kernel (for noise terms)
kDP = @(years1,years2,thetas) thetas(1).^2 * bsxfun(@times,(years1-refyear)',(years2-refyear)); % Deterministic Polynomial kernel (Linear time covariance)
kDELTAG = @(ad,thetas)thetas(1).^2.*(abs(ad)<1e-4).*(ad<360); % Geographic delta kernel (near zero angular distances; to detect localised signals)

kMat3d = @(years1,years2,dx,thetas)thetas(1).^2.*(-3/(thetas(2).^2)).*dx.*exp(-sqrt(3)*dx/thetas(2)).*(-1+2*bsxfun(@ge,years1',years2)); % first derivative of Matern 3/2
kMat5d = @(years1,years2,dx,thetas)thetas(1).^2.*(-5*dx.*exp(-sqrt(5)*dx/thetas(2))).*(thetas(2)+sqrt(5)*dx)/(3*thetas(2).^3); % first derivative of Matern 5/2
kDPd = @(years1,years2,thetas) thetas(1).^2 * repmat((years1-refyear)',length(years2),1); % first derivative of Deterministic Polynomial
kMat3dd = @(dx,thetas)thetas(1).^2.*(3/(thetas(2).^2)).*(1-sqrt(3)*dx/thetas(2)).*exp(-sqrt(3)*dx/thetas(2)); % second derivative of Matern 3/2
kMat5dd = @(dx,thetas)thetas(1).^2.*-(5*exp(-(sqrt(5)*dx)/thetas(2)).*(thetas(2).^2+sqrt(5)*thetas(2).*dx-5*dx.^2))/(3*thetas(2).^4); % second derivative of Matern 5/2
kDPdd = @(years1,years2,thetas) thetas(1).^2 * ones(length(years2),length(years1)); % second derivative of Deterministic Polynomial

clear modelspec;

%% defines global, regional-linear, regional non-linear, local, and white noise covariance functions
 cvfunc.G = @(dt1t2,thetas) kMat3(dt1t2,thetas(1:2)); % global kernel
 cvfunc.L = @(dt1t2,ad,thetas) (kMat3(dt1t2,thetas(1:2))).*(kMat3(ad,[1 thetas(3)])).*(ad<360); % local non-linear
 cvfunc.W = @(dt1t2,ad,thetas) kDELTAG(ad,1).*kDELTA(dt1t2,thetas(1)); % white noise

%% defines first derivatives
 dcvfunc.G = @(t1,t2,dt1t2,thetas) kMat3d(t1,t2,dt1t2,thetas(1:2)); % global
 dcvfunc.L = @(t1,t2,dt1t2,ad,thetas) (kMat3d(t1,t2,dt1t2,thetas(1:2))).*(kMat3(ad,[1 thetas(3)])).*(ad<360); % local non-linear
 dcvfunc.W = 0; % white noise

%% defines second derivatives
 ddcvfunc.G = @(dt1t2,thetas) kMat3dd(dt1t2,thetas(1:2)); % global
 ddcvfunc.L = @(dt1t2,ad,thetas) (kMat3dd(dt1t2,thetas(1:2))).*(kMat3(ad,[1 thetas(3)])).*(ad<360); % local non-linear
 ddcvfunc.W = 0; % white noise
 
%% ADD OR EXCLUDE TERMS HERE FOR MODEL SPEC: Assemble model structure
% covariance functions to use in training model
modelspec(1).cvfunc = @(t1,t2,dt1t2,thetas,ad,fp1fp2)  cvfunc.G(dt1t2,thetas(1:2)) + cvfunc.L(dt1t2,ad,thetas(3:5)) + cvfunc.W(dt1t2,ad,thetas(6));
% specify training model based on above covariance functions
modelspec(1).traincv = @(t1,t2,dt1t2,thetas,errcv,ad,fp1fp2) modelspec(1).cvfunc(t1,t2,dt1t2,thetas,ad,fp1fp2) + errcv;
% first derivatives: for model prediction from trained model  
modelspec(1).dcvfunc =  @(t1,t2,dt1t2,thetas,ad,fp1fp2) dcvfunc.G(t1,t2,dt1t2,thetas(1:2)) + dcvfunc.L(t1,t2,dt1t2,ad,thetas(3:5));    
% second derivatives: for model prediction from trained model
modelspec(1).ddcvfunc =  @(t1,t2,dt1t2,thetas,ad,fp1fp2) ddcvfunc.G(dt1t2,thetas(1:2)) + ddcvfunc.L(dt1t2,ad,thetas(3:5)); 

% covariance functions to use in training model
modelspec(2).cvfunc = @(t1,t2,dt1t2,thetas,ad,fp1fp2)  cvfunc.G(dt1t2,thetas(1:2)) + cvfunc.L(dt1t2,ad,thetas(3:5)) + cvfunc.W(dt1t2,ad,thetas(6));
% specify training model based on above covariance functions
modelspec(2).traincv = @(t1,t2,dt1t2,thetas,errcv,ad,fp1fp2) modelspec(1).cvfunc(t1,t2,dt1t2,thetas,ad,fp1fp2) + errcv;
% first derivatives: for model prediction from trained model  
modelspec(2).dcvfunc =  @(t1,t2,dt1t2,thetas,ad,fp1fp2) dcvfunc.G(t1,t2,dt1t2,thetas(1:2)) + dcvfunc.L(t1,t2,dt1t2,ad,thetas(3:5));    
% second derivatives: for model prediction from trained model
modelspec(2).ddcvfunc =  @(t1,t2,dt1t2,thetas,ad,fp1fp2) ddcvfunc.G(dt1t2,thetas(1:2)) + ddcvfunc.L(dt1t2,ad,thetas(3:5)); 

% covariance functions to use in training model
modelspec(3).cvfunc = @(t1,t2,dt1t2,thetas,ad,fp1fp2)  cvfunc.G(dt1t2,thetas(1:2)) + cvfunc.L(dt1t2,ad,thetas(3:5)) + cvfunc.W(dt1t2,ad,thetas(6));
% specify training model based on above covariance functions
modelspec(3).traincv = @(t1,t2,dt1t2,thetas,errcv,ad,fp1fp2) modelspec(1).cvfunc(t1,t2,dt1t2,thetas,ad,fp1fp2) + errcv;
% first derivatives: for model prediction from trained model  
modelspec(3).dcvfunc =  @(t1,t2,dt1t2,thetas,ad,fp1fp2) dcvfunc.G(t1,t2,dt1t2,thetas(1:2)) + dcvfunc.L(t1,t2,dt1t2,ad,thetas(3:5));    
% second derivatives: for model prediction from trained model
modelspec(3).ddcvfunc =  @(t1,t2,dt1t2,thetas,ad,fp1fp2) ddcvfunc.G(dt1t2,thetas(1:2)) + ddcvfunc.L(dt1t2,ad,thetas(3:5)); 

%% Specify parameter ranges for kernels (starting point, lower bound of search, upper bound of search)
tluTGG1 = [
 
    500 1 120000    % 1 Matern3/2 global amplitude 
    100 1 80000  % 2 Temporal lengthscale for global kernel
    
    100 0.01 40000    % 3 Matern local amplitude
    100 1 40000     % 4 Temporal parameters
    0.01 0.001 2     % 5 Spatial length scale
 
    100 0.1 10e5    % 6 white noise
         ];

modelspec(1).thet0=tluTGG1(:,1)'; % define starting value
modelspec(1).lb = tluTGG1(:,2)'; % define lower bounds
modelspec(1).ub = tluTGG1(:,3)'; % define upper bounds

tluTGG2 = [
 
    5000 1000 100000    % 1 Matern3/2 global amplitude 
    100000 100000 400000  % 2 Temporal lengthscale for global kernel
    
    1000 10 400000    % 3 Matern local amplitude
    1000 10 400000     % 4 Temporal parameters
    5 1 50     % 5 Spatial length scale
 
    1000 1 10e5    % 6 white noise
         ];

modelspec(2).thet0=tluTGG2(:,1)'; % define starting value
modelspec(2).lb = tluTGG2(:,2)'; % define lower bounds
modelspec(2).ub = tluTGG2(:,3)'; % define upper bounds

tluTGG3 = [
 
    500000 30000 1000000    % 1 Matern3/2 global amplitude 
    2000000 100000 4000000  % 2 Temporal lengthscale for global kernel
    
    5500 1000 10000    % 3 Matern local amplitude
    500000 10000 1000000     % 4 Temporal parameters
    5000 6 10000     % 5 Spatial length scale
 
    5000 40 10000    % 6 white noise
         ];

modelspec(3).thet0=tluTGG3(:,1)'; % define starting value
modelspec(3).lb = tluTGG3(:,2)'; % define lower bounds
modelspec(3).ub = tluTGG3(:,3)'; % define upper bounds

tluTGG4 = [
 
    200 1 200000    % 1 Matern3/2 global amplitude 
    100 1 80000  % 2 Temporal lengthscale for global kernel
    
    100 0.01 40000    % 3 Matern local amplitude
    100 1 40000     % 4 Temporal parameters
    0.005 0.001 0.01     % 5 Spatial length scale
 
    100 0.1 10e5    % 6 white noise
         ];

modelspec(4).thet0=tluTGG4(:,1)'; % define starting value
modelspec(4).lb = tluTGG4(:,2)'; % define lower bounds
modelspec(4).ub = tluTGG4(:,3)'; % define upper bounds


%% Specify in modelspec the priors for kernels
 
% LIST INDICES FOR TERMS HERE
modelspec(1).subfixed=[];
modelspec(1).sublength=[5]; % spatial lengthscale
modelspec(1).subamp = [1 3 6]; % global, local and white noise amplitudes
modelspec(1).subamplinear = [];
modelspec(1).subampnonlinear = [];
modelspec(1).subampoffset = [];
modelspec(1).subampnoise = [6]; % white noise
modelspec(1).subampHF = [];
modelspec(1).label='global+local+noise 1';

modelspec(2).subfixed=[];
modelspec(2).sublength=[5]; % spatial lengthscale
modelspec(2).subamp = [1 3 6]; % global, local and white noise amplitudes
modelspec(2).subamplinear = [];
modelspec(2).subampnonlinear = [];
modelspec(2).subampoffset = [];
modelspec(2).subampnoise = [6]; % white noise
modelspec(2).subampHF = [];
modelspec(2).label='global+local+noise 2';

modelspec(3).subfixed=[];
modelspec(3).sublength=[5]; % spatial lengthscale
modelspec(3).subamp = [1 3 6]; % global, local and white noise amplitudes
modelspec(3).subamplinear = [];
modelspec(3).subampnonlinear = [];
modelspec(3).subampoffset = [];
modelspec(3).subampnoise = [6]; % white noise
modelspec(3).subampHF = [];
modelspec(3).label='global+local+noise 3';

modelspec(4).subfixed=[];
modelspec(4).sublength=[5]; % spatial lengthscale
modelspec(4).subamp = [1 3 6]; % global, local and white noise amplitudes
modelspec(4).subamplinear = [];
modelspec(4).subampnonlinear = [];
modelspec(4).subampoffset = [];
modelspec(4).subampnoise = [6]; % white noise
modelspec(4).subampHF = [];
modelspec(4).label='global+local+noise 3';

